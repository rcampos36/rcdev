# Copy this file to ".env.local" for local development.
# Next.js does not load .env.example.
# After changing ADMIN_PASSWORD, restart the server.
ADMIN_PASSWORD=

# Required to save images and CMS content on Vercel.
# Storage → Blob store → Projects → Connect to Project → Production, then Redeploy.
# A Private store is fine; the app uploads with access: 'private' and serves images
# through /api/cms-image. Connecting injects BLOB_STORE_ID.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=


