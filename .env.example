# Copy this file to ".env.local" for local development.
# Next.js does not load .env.example.
# After changing ADMIN_PASSWORD, restart the server.
ADMIN_PASSWORD=

# Required to save images and CMS content on Vercel.
# Storage → Blob store → Projects → Connect to Project → Production, then Redeploy.
# A Private store is fine. If uploads fail with "Failed to fetch", also copy
# BLOB_READ_WRITE_TOKEN from the store's .env.local tab into Production env vars.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=


