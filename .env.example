# Copy this file to ".env.local" for local development.
# Next.js does not load .env.example.
# After changing ADMIN_PASSWORD, restart the server.
ADMIN_PASSWORD=

# Required to save images and CMS content on Vercel.
# Storage → Blob store → Projects → Connect to Project → Production, then Redeploy.
# Connecting injects BLOB_STORE_ID. You do not need BLOB_READ_WRITE_TOKEN unless you
# want a local upload path or the store was not connected to this project.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=


