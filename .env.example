ADMIN_PASSWORD=change-me

# Required to save images and CMS content on Vercel.
# Connect the Blob store to this project (Storage → store → Projects → Connect to Project), then redeploy.
# Vercel may add BLOB_STORE_ID instead of BLOB_READ_WRITE_TOKEN; either works.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=


